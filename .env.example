# ─────────────────────────────────────────────────────────────
# GitTime Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# ── GitHub OAuth ──────────────────────────────────────────────
# Create an OAuth App at: https://github.com/settings/developers
# Homepage URL: http://localhost:3000 (or your production domain)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=your_github_oauth_client_id
GITHUB_SECRET=your_github_oauth_client_secret

# ── NextAuth Configuration ────────────────────────────────────
# Generate a secure random string with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_key_min_32_chars
NEXTAUTH_URL=http://localhost:3000

# ── MongoDB Database ──────────────────────────────────────────
# MongoDB Atlas connection string or local MongoDB instance
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/gittime?retryWrites=true&w=majority
# Local: mongodb://127.0.0.1:27017/gittime
MONGODB_URI=mongodb://127.0.0.1:27017/gittime

# ── Razorpay Payment Gateway (Optional / Pro Tier) ───────────
# Get your API keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Public key exposed to the browser for checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
# Optional: Webhook Secret from Razorpay Webhook settings
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Groq AI Engine (For Context-Aware AI Commit Messages) ───────
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key

# ── Web3Forms (Support & Contact Form Modal) ───────────────────
# Get your access key at: https://web3forms.com (free)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key
